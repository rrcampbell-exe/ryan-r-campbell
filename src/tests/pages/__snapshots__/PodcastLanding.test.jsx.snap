                aria-controls="mobile-navigation"
                aria-expanded="false"
                aria-label="Open navigation menu"
                class="hamburger-trigger"
                type="button"
              >
                <svg
                  id="hamburger-icon"
                  version="1.1"
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                  xmlns:xlink="http://www.w3.org/1999/xlink"
                >
                  <title>
                    Menu
                  </title>
                  <g
                    fill="none"
                    fill-rule="evenodd"
                    id="Page-1"
                    stroke="none"
                    stroke-width="1"
                  >
                    <g
                      id="Menu"
                    >
                      <rect
                        fill-rule="nonzero"
                        height="24"
                        id="Rectangle"
                        width="24"
                        x="0"
                        y="0"
                      />
                      <line
                        id="Path"
                        stroke-linecap="round"
                        stroke-width="1.5"
                        x1="5"
                        x2="19"
                        y1="7"
                        y2="7"
                      />
