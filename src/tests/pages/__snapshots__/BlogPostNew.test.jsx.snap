exports[`BlogPost > default snapshot 1`] = `
{
  "asFragment": [Function],
  "baseElement": <body>
    <div>
      <div
        class="undefined"
      >
        <header
          class="Header"
        >
          <a
            aria-label="Home"
            class="link wordmark-link"
            href="/"
          >
            <span
              class="wordmark"
            >
              ryan r
              <span
                class="wordmark-dot"
              >
                .
              </span>
               campbell
            </span>
            <span
              aria-hidden="true"
              class="page-subtitle"
            >
              author | technologist
            </span>
          </a>
          <nav
            aria-label="Site navigation"
            class="header-nav"
          >
            <a
              aria-current="page"
              class="header-nav__link active"
              href="/"
            >
              home
            </a>
            <a
              class="header-nav__link"
              href="/about"
            >
              about
            </a>
            <a
              class="header-nav__link"
              href="https://ryanrcampbell.substack.com"
              rel="noopener noreferrer"
              target="_blank"
            >
              writing
            </a>
            <a
              class="header-nav__link"
              href="/books"
            >
              books
            </a>
            <a
              class="header-nav__link"
              href="/podcasts"
            >
              archive
            </a>
          </nav>
          <div
            class="header-toggles"
          >
            <div
              class="Hamburger-menu "
              data-testid="menu"
            >
              <button
                aria-controls="mobile-navigation"
                aria-expanded="false"
                aria-label="Open navigation menu"
                class="hamburger-trigger"
                type="button"
              >
                <svg
                  id="hamburger-icon"
                  version="1.1"
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                  xmlns:xlink="http://www.w3.org/1999/xlink"
                >
                  <title>
                    Menu
                  </title>
                  <g
                    fill="none"
                    fill-rule="evenodd"
                    id="Page-1"
                    stroke="none"
                    stroke-width="1"
                  >
                    <g
                      id="Menu"
                    >
                      <rect
                        fill-rule="nonzero"
                        height="24"
                        id="Rectangle"
                        width="24"
                        x="0"
                        y="0"
                      />
                      <line
                        id="Path"
                        stroke-linecap="round"
                        stroke-width="1.5"
                        x1="5"
                        x2="19"
                        y1="7"
                        y2="7"
                      />
                      <line
                        id="Path"
                        stroke-linecap="round"
                        stroke-width="1.5"
                        x1="5"
                        x2="19"
                        y1="17"
                        y2="17"
                      />
                      <line
                        id="Path"
                        stroke-linecap="round"
                        stroke-width="1.5"
                        x1="5"
                        x2="19"
                        y1="12"
                        y2="12"
                      />
                    </g>
                  </g>
                </svg>
              </button>
            </div>
          </div>
        </header>
        <main>
          <div
            class="Post"
          >
            <div
              class="masthead"
            >
              <img
                alt="A cut-out image of Ryan R. Campbell next to text that welcomes visitors to the new website."
                class="cover-image"
                src="/post-content/2024/05/welcome-to-the-new-site-cover-img.png"
              />
              <div>
                <h2
                  class="title"
                >
                  Welcome to the New Ryan R. Campbell (Or at Least the New Website)
                </h2>
                <div
                  class="credits"
                >
                  <div
                    class="byline-container"
                  >
                    <div
                      class="author-photo"
                    >
                      <img
                        alt="A headshot of Ryan R. Campbell"
                        src="/2024-ryan-r-campbell-website-headshot.png"
                      />
                    </div>
                    <div>
                      <p>
                        Written by Ryan R. Campbell
                      </p>
                      <p
                        class="posted-on-date"
                      >
                        Posted on 
                        May 3, 2024
                      </p>
                    </div>
                  </div>
                  <p
                    class="bio"
                  >
                    Ryan R. Campbell is a strategic software engineer and technical leader at Northwestern Mutual, where he drives AI enablement, developer experience, and frontend platform modernization at enterprise scale. He is also a two-time International Book Awards finalist and the founder of the Writescast Network.
                  </p>
                  <div
                    class="content-post-underline"
                  />
                </div>
                <div
                  class="tags"
                >
                  <div
                    class="Blog-tags"
                  >
                    <div
                      class="content-post-underline"
                    />
                    <p>
                      FILED UNDER:
                    </p>
                    <div
                      class="tags-container"
                    >
                      <span
                        class="tag grow-on-hover"
                      >
                        Site Migration
                      </span>
                      <span
                        class="tag grow-on-hover"
                      >
                        Web Development
                      </span>
                      <span
                        class="tag grow-on-hover"
                      >
                        Writing
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <article
              data-testid="article"
            >
              <p>
                Loading...
              </p>
            </article>
            <div
              class="nav-footer"
            >
              <div
                class="post-nav-container previous-post"
              >
                <a
                  title="link to previous post"
                >
                  &lt; previous post
                </a>
                <span>
                  From Conference to Coffee (On the Beach)
                </span>
              </div>
              <div
                class="post-nav-container next-post"
              >
                <a
                  title="link to next post"
                >
                  next post &gt;
                </a>
                <span>
                  Book Review: The Good Enough Job
                </span>
              </div>
            </div>
          </div>
        </main>
        <div
          data-testid="analytics"
        />
        <div
          data-testid="speed-insights"
        />
        <footer
          class="Footer"
          id="contact"
        >
          <div
            class="footer-inner"
          >
            <div
              class="footer-brand"
            >
              <a
                aria-label="Home"
                class="footer-wordmark"
                href="/"
              >
                ryan r
                <span
                  class="footer-dot"
                >
                  .
                </span>
                 campbell
              </a>
              <p
                class="footer-tagline"
              >
                Software engineer & author based in Milwaukee, WI.
              </p>
            </div>
            <nav
              aria-label="Footer navigation"
              class="footer-nav"
            >
              <span
                class="footer-nav-label"
              >
                Navigate
              </span>
              <ul>
                <li>
                  <a
                    href="/"
                  >
                    Home
                  </a>
                </li>
                <li>
                  <a
                    href="/about"
                  >
                    About
                  </a>
                </li>
                <li>
                  <a
                    href="https://ryanrcampbell.substack.com"
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    Writing
                  </a>
                </li>
                <li>
                  <a
                    href="/books"
                  >
                    Books
                  </a>
                </li>
                <li>
                  <a
                    href="/podcasts"
                  >
                    Archive
                  </a>
                </li>
                <li>
                  <a
                    href="/contact"
                  >
                    Contact
                  </a>
                </li>
              </ul>
            </nav>
            <div
              class="footer-connect"
            >
              <span
                class="footer-nav-label"
              >
                Connect
              </span>
              <ul>
                <li>
                  <a
                    href="https://www.linkedin.com/in/ryan-r-campbell/"
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    LinkedIn
                  </a>
                </li>
                <li>
                  <a
                    href="https://ryanrcampbell.substack.com"
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    Substack
                  </a>
                </li>
                <li>
                  <a
                    href="https://github.com/rrcampbell-exe"
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    GitHub
                  </a>
                </li>
              </ul>
            </div>
            <div
              class="footer-contact"
            >
              <span
                class="footer-nav-label"
              >
                Contact (Gmail)
              </span>
              <div
                class="footer-contact__grid"
              >
                <div>
                  <p
                    class="footer-contact__label"
                  >
                    tech inquiries
                  </p>
                  <p>
                    campbell.ryan.r
                  </p>
                </div>
                <div>
                  <p
                    class="footer-contact__label"
                  >
                    author inquiries
                  </p>
                  <p>
