                      class="book-cover"
                      data-testid="book-cover"
                      height="2700"
                      src="./books/and-ampersand/and-ampersand-flat-cover.png"
                      width="1800"
                    />
                  </div>
                  <h3
                    class="book-title"
                  >
                    And Ampersand
                  </h3>
                  <p>
