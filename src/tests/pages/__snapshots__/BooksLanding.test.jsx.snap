                style="aspect-ratio: 1800 / 2700;"
              >
                <div
                  class="book-cover-tilt"
                >
                  <img
                    alt="The black cover of the book And Ampersand by Ryan R. Campbell, which features two large ampersands in gold and white, respectively"
                    class="book-cover"
                    height="2700"
                    src="./books/and-ampersand/and-ampersand-flat-cover.png"
                    width="1800"
                  />
                  <div
