      "embedCode": "<blockquote class="wp-embedded-content" data-secret="RpElpRVUYB"><a href="https://ryanrcampbell.com/2017/09/12/writescast-raconteurs-week-one-recap/">Writescast Raconteurs: Week One Recap</a></blockquote><iframe sandbox="allow-scripts" security="restricted" src="https://ryanrcampbell.com/2017/09/12/writescast-raconteurs-week-one-recap/embed/#?secret=RpElpRVUYB" width="500" height="350" title="“Writescast Raconteurs: Week One Recap” &#8212; Ryan R. Campbell" data-secret="RpElpRVUYB" frameborder="0" marginwidth="0" marginheight="0" scrolling="no" class="wp-embedded-content"></iframe><script type="text/javascript">
