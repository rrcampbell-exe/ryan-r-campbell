    "excerpt": {
      "protected": false,
      "rendered": "And Ampersand: Short Stories on Endings and Beginnings (of a Sort) has hardly been out for a full day, and it's already receiving rave reviews.",
    },
    "featured_media": 9577,
    "format": "standard",
    "guid": {
