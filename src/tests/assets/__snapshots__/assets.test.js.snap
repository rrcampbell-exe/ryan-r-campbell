    },
    "explicit": {
      "__prefix": "itunes",
      "__text": "no",
    },
    "guid": {
      "__text": "https://ryanrcampbell.com/?post_type=podcast&p=5061",
      "_isPermaLink": "false",
    },
    "image": {
      "__prefix": "itunes",
