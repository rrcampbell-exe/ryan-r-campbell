    "episode_player_image": "https://i0.wp.com/ryanrcampbell.com/wp-content/uploads/2020/12/2020-Writescast-Network-Logo.jpg?fit=3000%2C3000&ssl=1",
    "excerpt": {
      "protected": false,
      "rendered": "Somewhere in an empty office sits an empty chair. This chair was filled once, was party to a purpose only one person could realize. Like many of us, this person was a writer, but to so many, she was much, much more. An inspiration. A community leader. A mother. A wife. This writer was one […]",
    },
