uot;&quot;,&quot;focal_length&quot;:&quot;4.25&quot;,&quot;iso&quot;:&quot;25&quot;,&quot;shutter_speed&quot;:&quot;0.0017241379310345&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;1&quot;}" data-image-title="Hermit Crab" data-image-description="" data-image-caption="&lt;p&gt;A hermit crab makes a daring attempt to climb wooden stairs at Playa Sandy Beach in Rincón.&lt;/p&gt;
